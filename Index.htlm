<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, viewport-fit=cover"
  >

  <meta name="theme-color" content="#ffffff">

  <title>Zackary sh🛍️p</title>

  <style>

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display",
        "Segoe UI", Arial, sans-serif;

      background: #f7f7f7;
      color: #111;

      padding-bottom: 85px;
    }

    /* HEADER */

    header {
      background: #ffffff;
      padding:
        18px
        18px
        12px;

      border-bottom: 1px solid #eeeeee;
    }

    .top-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 24px;
      font-weight: 800;
      letter-spacing: -1px;
    }

    .account {
      width: 40px;
      height: 40px;

      border-radius: 50%;

      background: #f1f1f1;

      display: flex;
      align-items: center;
      justify-content: center;

      font-size: 20px;
    }

    .subtitle {
      margin-top: 4px;
      color: #777;
      font-size: 13px;
    }


    /* SEARCH */

    .search {
      padding: 12px 18px 10px;
      background: #fff;
    }

    .search-box {
      display: flex;
      align-items: center;

      background: #f2f2f2;

      border-radius: 14px;

      padding: 0 14px;
    }

    .search-box span {
      font-size: 18px;
      margin-right: 8px;
    }

    .search-box input {
      width: 100%;

      border: none;
      outline: none;

      background: transparent;

      padding: 13px 0;

      font-size: 15px;
    }


    /* CATEGORIES */

    .categories {
      display: flex;

      gap: 8px;

      overflow-x: auto;

      padding: 10px 18px 15px;

      background: #fff;

      scrollbar-width: none;
    }

    .categories::-webkit-scrollbar {
      display: none;
    }

    .category {
      border: none;

      background: #f1f1f1;

      padding: 9px 15px;

      border-radius: 25px;

      white-space: nowrap;

      font-size: 13px;

      color: #333;
    }

    .category.active {
      background: #111;
      color: white;
    }


    /* HERO */

    .hero {
      margin: 18px;

      background: #111;

      color: white;

      border-radius: 20px;

      padding: 24px 20px;

      position: relative;

      overflow: hidden;
    }

    .hero h2 {
      font-size: 24px;

      line-height: 1.1;

      max-width: 240px;
    }

    .hero p {
      margin-top: 8px;

      color: #cccccc;

      font-size: 13px;

      line-height: 1.5;

      max-width: 250px;
    }

    .hero button {
      margin-top: 16px;

      border: none;

      background: white;

      color: #111;

      padding: 11px 16px;

      border-radius: 10px;

      font-weight: 600;
    }


    /* SECTION */

    .section-header {
      display: flex;

      justify-content: space-between;

      align-items: center;

      padding: 5px 18px 12px;
    }

    .section-header h2 {
      font-size: 20px;
    }

    .section-header button {
      border: none;

      background: none;

      color: #666;

      font-size: 13px;
    }


    /* PRODUCTS */

    .products {
      display: grid;

      grid-template-columns: repeat(2, minmax(0, 1fr));

      gap: 12px;

      padding: 0 18px;
    }

    .product {
      background: white;

      border-radius: 16px;

      overflow: hidden;

      box-shadow:
        0 3px 12px rgba(0,0,0,0.06);
    }

    .product-image {
      position: relative;
    }

    .product img {
      width: 100%;

      height: 190px;

      object-fit: cover;

      display: block;
    }

    .favorite {
      position: absolute;

      top: 10px;
      right: 10px;

      width: 32px;
      height: 32px;

      border-radius: 50%;

      border: none;

      background: rgba(255,255,255,0.92);

      font-size: 16px;
    }

    .product-info {
      padding: 12px;
    }

    .product h3 {
      font-size: 14px;

      margin-bottom: 6px;

      white-space: nowrap;

      overflow: hidden;

      text-overflow: ellipsis;
    }

    .price {
      font-size: 16px;

      font-weight: 800;

      margin-bottom: 6px;
    }

    .location {
      color: #777;

      font-size: 11px;

      margin-bottom: 10px;
    }

    .order-btn {
      width: 100%;

      border: none;

      background: #111;

      color: white;

      padding: 10px;

      border-radius: 9px;

      font-size: 13px;

      font-weight: 600;
    }


    /* SELL BUTTON */

    .sell-section {
      margin: 25px 18px;
    }

    .sell-button {
      width: 100%;

      border: 1px solid #111;

      background: white;

      color: #111;

      padding: 14px;

      border-radius: 13px;

      font-size: 15px;

      font-weight: 700;
    }


    /* FOOTER */

    footer {
      background: #111;

      color: white;

      padding: 30px 18px;

      text-align: center;

      line-height: 1.8;

      margin-top: 25px;
    }

    footer p {
      color: #bbb;

      font-size: 12px;
    }

    footer strong {
      display: block;

      margin-top: 10px;

      color: white;

      font-size: 13px;
    }


    /* BOTTOM NAVIGATION */

    .bottom-menu {
      position: fixed;

      bottom: 0;
      left: 0;
      right: 0;

      height: 72px;

      background: rgba(255,255,255,0.96);

      backdrop-filter: blur(15px);

      -webkit-backdrop-filter: blur(15px);

      border-top: 1px solid #e5e5e5;

      display: flex;

      justify-content: space-around;

      align-items: center;

      z-index: 1000;

      padding-bottom: env(safe-area-inset-bottom);
    }

    .bottom-menu button {
      border: none;

      background: none;

      color: #777;

      font-size: 11px;

      text-align: center;
    }

    .bottom-menu button span {
      display: block;

      font-size: 21px;

      margin-bottom: 3px;
    }

    .bottom-menu .active {
      color: #111;

      font-weight: 700;
    }


    /* IPHONE OPTIMIZATION */

    @media (min-width: 700px) {

      .products {
        grid-template-columns:
          repeat(4, minmax(0, 1fr));
      }

      body {
        max-width: 1100px;

        margin: auto;
      }

      .bottom-menu {
        max-width: 1100px;

        margin: auto;
      }
    }

  </style>
</head>


<body>


  <!-- HEADER -->

  <header>

    <div class="top-header">

      <div>
        <div class="logo">
          Zackary sh🛍️p
        </div>

        <div class="subtitle">
          La marketplace de Byemassi
        </div>
      </div>

      <div class="account">
        👤
      </div>

    </div>

  </header>


  <!-- SEARCH -->

  <div class="search">

