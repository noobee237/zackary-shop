          alt="T-shirt Premium"
        >

        <button class="favorite">
          ♡
        </button>

      </div>

      <div class="product-info">

        <h3>
          T-shirt Premium
        </h3>

        <p class="price">
          8 000 FCFA
        </p>

        <p class="location">
          📍 Byemassi • 🚚 Livraison
        </p>

        <button class="order-btn">
          Voir l'article
        </button>

      </div>

    </div>


    <!-- PRODUCT 2 -->

    <div class="product">

      <div class="product-image">

        <img
          src="https://images.unsplash.com/photo-1551488831-00ddcb6c6bd3?auto=format&fit=crop&w=600&q=80"
          alt="Ensemble Streetwear"
        >

        <button class="favorite">
          ♡
        </button>

      </div>

      <div class="product-info">

        <h3>
          Ensemble Streetwear
        </h3>

        <p class="price">
          20 000 FCFA
        </p>

        <p class="location">
          📍 Byemassi • 🚚 Livraison
        </p>

        <button class="order-btn">
          Voir l'article
        </button>

      </div>

    </div>


    <!-- PRODUCT 3 -->

    <div class="product">

      <div class="product-image">

        <img
          src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=600&q=80"
          alt="Chaussures"
        >

        <button class="favorite">
          ♡
        </button>

      </div>

      <div class="product-info">

        <h3>
          Sneakers Urban
        </h3>

        <p class="price">
          25 000 FCFA
        </p>

        <p class="location">
          📍 Byemassi • 🚚 Livraison
        </p>

        <button class="order-btn">
          Voir l'article
        </button>

      </div>

    </div>


    <!-- PRODUCT 4 -->

    <div class="product">

      <div class="product-image">

        <img
          src="https://images.unsplash.com/photo-1529139574466-a303027c1d8b?auto=format&fit=crop&w=600&q=80"
          alt="Mode"
        >

        <button class="favorite">
          ♡
        </button>

      </div>

      <div class="product-info">

        <h3>
          Look tendance
        </h3>

        <p class="price">
          18 000 FCFA
        </p>

        <p class="location">
          📍 Byemassi • 🚚 Livraison
        </p>

        <button class="order-btn">
          Voir l'article
        </button>

      </div>

    </div>


  </main>


  <!-- SELL -->

  <section class="sell-section">

    <button class="sell-button">
      ➕ Vendre un article
    </button>

  </section>


  <!-- FOOTER -->

  <footer>

    <p>
      © 2026 Zackary sh🛍️p
    </p>

    <p>
      Livraison : 1 000 FCFA
    </p>

    <p>
      Byemassi et environs
    </p>

    <p>
      Retrait : Lycée de Byemassi
    </p>

    <strong>
      Ce site est fait par 𝖓𝖔𝖛𝖎𝖘_𝖋𝖇♛
    </strong>

    <p>
      WhatsApp : +237 690 847 035
    </p>

  </footer>


  <!-- BOTTOM MENU -->

  <nav class="bottom-menu">

    <button class="active">

      <span>🏠</span>

      Accueil

    </button>


    <button>

      <span>🛍️</span>

      Boutique

    </button>


    <button>

      <span>➕</span>

      Vendre

    </button>


    <button>

      <span>🛒</span>

      Commandes

    </button>


    <button>

      <span>👤</span>

      Compte

    </button>

  </nav>


</body>
</html>
